```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Application Approved - SH Healthcare System</title>
</head>

<body style="margin:0;padding:0;background-color:#f5f8fc;font-family:Arial,Helvetica,sans-serif;color:#172033;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color:#f5f8fc;padding:48px 16px;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:580px;background-color:#ffffff;border-radius:18px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="padding:28px 34px;border-bottom:1px solid #eef2f7;">
              <div style="display:inline-block;width:38px;height:38px;line-height:38px;text-align:center;background-color:#2563eb;color:#ffffff;border-radius:10px;font-size:18px;font-weight:700;vertical-align:middle;">
                SH
              </div>
              <span style="margin-left:10px;color:#172033;font-size:17px;font-weight:700;vertical-align:middle;">
                SH Healthcare System
              </span>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:42px 38px 38px;">

              <p style="margin:0 0 12px;color:#16a34a;font-size:13px;font-weight:600;letter-spacing:0.4px;">
                APPLICATION UPDATE
              </p>

              <h1 style="margin:0 0 16px;color:#111827;font-size:28px;line-height:1.25;font-weight:700;">
                Congratulations! Your Application is Approved
              </h1>

              <p style="margin:0 0 10px;color:#334155;font-size:15px;line-height:1.7;">
                Hello <strong><%= name %></strong>,
              </p>

              <p style="margin:0 0 24px;color:#64748b;font-size:15px;line-height:1.75;">
                We are pleased to inform you that your doctor application
                at SH Healthcare System has been successfully reviewed
                and approved.
              </p>

              <!-- Approval Status -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px;">
                <tr>
                  <td align="center" style="padding:25px 20px;">

                    <div style="width:48px;height:48px;line-height:48px;background-color:#dcfce7;border-radius:50%;color:#16a34a;font-size:25px;font-weight:700;text-align:center;">
                      &#10003;
                    </div>

                    <p style="margin:14px 0 6px;color:#166534;font-size:18px;font-weight:700;">
                      Application Approved
                    </p>

                    <p style="margin:0;color:#15803d;font-size:13px;line-height:1.6;">
                      Your doctor account has been verified successfully.
                    </p>

                  </td>
                </tr>
              </table>

              <p style="margin:24px 0 16px;color:#64748b;font-size:15px;line-height:1.75;">
                You can now proceed to access your doctor account.
                Please log in using your registered email address and
                complete any remaining account setup requirements.
              </p>

              <!-- Login Button -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="padding:8px 0 24px;">
                    <a href="<%= loginUrl %>"
                      style="display:inline-block;padding:14px 32px;background-color:#2563eb;color:#ffffff;text-decoration:none;border-radius:9px;font-size:14px;font-weight:700;">
                      Login to Your Account
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Security Note -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="border-top:1px solid #eef2f7;">
                <tr>
                  <td style="padding-top:24px;">
                    <p style="margin:0 0 8px;color:#334155;font-size:13px;font-weight:600;">
                      What's Next?
                    </p>

                    <p style="margin:0;color:#64748b;font-size:13px;line-height:1.7;">
                      Welcome to SH Healthcare System! We look forward
                      to having you as part of our healthcare community.
                      If you need assistance, please contact our support team.
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 38px;background-color:#fafbfc;border-top:1px solid #eef2f7;">

              <p style="margin:0 0 6px;color:#475569;font-size:12px;font-weight:600;">
                SH Healthcare System
              </p>

              <p style="margin:0;color:#94a3b8;font-size:11px;line-height:1.6;">
                This is an automated message. Please do not reply to this email.
              </p>

              <p style="margin:10px 0 0;color:#94a3b8;font-size:11px;">
                &copy; 2026 SH Healthcare System. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
```