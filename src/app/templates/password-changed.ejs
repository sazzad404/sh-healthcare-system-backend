                    text-align: center;
                    background-color: #2563eb;
                    color: #ffffff;
                    border-radius: 10px;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-align: middle;
                  "
                >
                  SH
                </div>

                <span
                  style="
                    margin-left: 10px;
